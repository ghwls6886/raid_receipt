# 로컬 dev 서버를 "클라우드(실) Supabase" 에 붙일 때 쓰는 파일.
# 이 파일을 `.env.cloud.local` 로 복사한 뒤 값을 채운다 (.gitignore 의 `.env.*.local` 로 제외됨).
#
#   pnpm --filter web dev:cloud     ← .env.cloud.local 이 .env 를 덮어쓴다
#   pnpm --filter web dev           ← 기존대로 로컬 Docker 스택
#
# 값 위치: Supabase 대시보드 > Project Settings > API
# ⚠️ service_role(secret) 키는 절대 넣지 말 것. VITE_ 값은 브라우저 번들에 그대로 박힌다.

VITE_SUPABASE_URL=https://<your-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon / publishable key>
