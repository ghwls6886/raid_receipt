{
  "name": "raid_receipt",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.29.2",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "lint": "turbo lint",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local > apps/web/src/lib/database.types.ts",
    "db:types:remote": "supabase gen types typescript --linked > apps/web/src/lib/database.types.ts"
  },
  "devDependencies": {
    "prettier": "^3.8.1",
    "supabase": "^2.110.0",
    "turbo": "^2.8.16",
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@swc/core",
      "unrs-resolver"
    ]
  }
}
